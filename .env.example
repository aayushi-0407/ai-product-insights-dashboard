# Environment Variables Template
# Copy this to .env and fill in your API keys

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-key-here

# Groq API Key (optional; enables LLM-based cluster labels and richer RAG answers)
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Pinecone API Key (get from https://app.pinecone.io/)
# Create an index named "review-chunks" with dimension 1536 and metric "cosine"
PINECONE_API_KEY=pcsk_your-key-here

# PostgreSQL Database URL (optional, for metadata storage)
# Local: postgresql://postgres:password@localhost:5432/reviews_db
# Or use a managed service: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/reviews_db

# Optional: Hugging Face token (if dataset requires authentication)
HF_TOKEN=

# Optional: Pinecone settings (usually defaults work fine)
# PINECONE_INDEX_NAME=review-chunks
# PINECONE_NAMESPACE=reviews
